        <mxCell id="u2gb9ee3fLgLlJ5zN_Mv-1690" value="Не смотря даже на различные ручные и автоматические проверки - никто не исключает человеческой и технической ошибки, и даже одна такая ошибка может привести к катастрофическим финансовым, юридическим и репутационным потерям" style="rounded=1;fillColor=#f08e81;strokeColor=none;strokeWidth=3;shadow=0;html=1;fontColor=#FFFFFF;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1360" width="176" height="190" as="geometry" />
        </mxCell>
        <mxCell id="u2gb9ee3fLgLlJ5zN_Mv-1691" value="" style="edgeStyle=none;endArrow=none;strokeWidth=3;strokeColor=#F08E81;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=1;exitDx=0;exitDy=0;" parent="1" source="1352" target="u2gb9ee3fLgLlJ5zN_Mv-1675" edge="1">
