        <mxCell id="u2gb9ee3fLgLlJ5zN_Mv-1587" value="Можем ввести в заблуждение клиентов, как итог их потеря, либо же репутационные риски" style="rounded=1;fillColor=#64BBE2;strokeColor=none;strokeWidth=3;shadow=0;html=1;fontColor=#FFFFFF;whiteSpace=wrap;" parent="1" vertex="1">
