        <mxCell id="u2gb9ee3fLgLlJ5zN_Mv-1692" value="&lt;b&gt;Критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
