            <mxPoint x="1365" y="634" as="sourcePoint" />
            <mxPoint x="1180" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="u2gb9ee3fLgLlJ5zN_Mv-1610" value="Может затруднить внутренние процессы компании, анализ бизнес-показателей и деятельности компании, а так же снижает наблюдаемость и безопасность в системе - по потерянной диагностике мы можем не заметить факт проникновения или проблемы, а так же увеличится срок ее исправления" style="rounded=1;fillColor=#f5af58;strokeColor=none;strokeWidth=3;shadow=0;html=1;fontColor=#FFFFFF;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1410" y="204" width="180" height="200" as="geometry" />
